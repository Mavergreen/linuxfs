+#ifdef __APPLE__
+/* Darwin has no timer_create(); a one-shot dispatch timer source stands in. */
+struct darwin_timer {
+	dispatch_source_t source;
+	dispatch_semaphore_t cancelled;
+	void (*fn)(void);
+	int free_on_cancel;
+};
+
+static __thread struct darwin_timer *timer_firing;
+
+static void darwin_timer_fire(void *arg)
+{
+	struct darwin_timer *t = arg;
+
+	timer_firing = t;
+	t->fn();
+	timer_firing = NULL;
 }
 
+static void darwin_timer_release(struct darwin_timer *t)
+{
+	dispatch_release(t->source);
+	dispatch_release(t->cancelled);
+	free(t);
+}
+
+static void darwin_timer_cancelled(void *arg)
+{
+	struct darwin_timer *t = arg;
+
+	if (t->free_on_cancel)
+		darwin_timer_release(t);
+	else
+		dispatch_semaphore_signal(t->cancelled);
+}
+
+static void *timer_alloc(void (*fn)(void))
+{
+	struct darwin_timer *t = calloc(1, sizeof(*t));
+
+	if (!t)
+		return NULL;
+	t->fn = fn;
+	t->cancelled = dispatch_semaphore_create(0);
+	t->source = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0,
+		dispatch_get_global_queue(DISPATCH_QUEUE_PRIORITY_HIGH, 0));
+	if (!t->cancelled || !t->source) {
+		if (t->cancelled)
+			dispatch_release(t->cancelled);
+		free(t);
+		return NULL;
+	}
+	dispatch_set_context(t->source, t);
+	dispatch_source_set_event_handler_f(t->source, darwin_timer_fire);
+	dispatch_source_set_cancel_handler_f(t->source, darwin_timer_cancelled);
+	dispatch_source_set_timer(t->source, DISPATCH_TIME_FOREVER,
+				  DISPATCH_TIME_FOREVER, 0);
+	dispatch_resume(t->source);
+	return t;
+}
+
+static int timer_set_oneshot(void *_timer, unsigned long ns)
+{
+	struct darwin_timer *t = _timer;
+
+	dispatch_source_set_timer(t->source,
+				  dispatch_time(DISPATCH_TIME_NOW, ns),
+				  DISPATCH_TIME_FOREVER, 0);
+	return 0;
+}
+
+/*
+ * Returns only once the callback can no longer run, except when called from
+ * the timer's own callback, where waiting would deadlock: then the cancel
+ * handler, which runs after the callback returns, frees the timer.
+ */
+static void timer_free(void *_timer)
+{
+	struct darwin_timer *t = _timer;
+
+	if (timer_firing == t) {
+		t->free_on_cancel = 1;
+		dispatch_source_cancel(t->source);
+		return;
+	}
+	dispatch_source_cancel(t->source);
+	dispatch_semaphore_wait(t->cancelled, DISPATCH_TIME_FOREVER);
+	darwin_timer_release(t);
+}
