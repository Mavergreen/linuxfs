lklfuse: on Darwin, names are stored NFC, shown as HFS+ shows them, and found in any normalization form

Mac programs name files in either Unicode normalization form, and macFUSE's libfuse makes it worse: it names its
nodes NFD (ICU's unorm2 NFD, in its node table) and builds every path from those names, except a new entry's last
component, which it passes as the kernel gave it. Linux filesystems store a name's bytes as given, and Linux's own
programs write NFC. The census (push A, run 45550175916) found the result: a shell create of NFC "café" landed on
disk as NFC and then failed with ENXIO, and a Linux-made NFC name opened by neither form. The ENXIO: libfuse's
create succeeds (its follow-up getattr uses the open file), but it hashes the new node under its NFD name, so the
kernel's next call on the node, a getattr, comes by an NFD path that names nothing. macFUSE's kernel side then
drops the vnode, and the open ends ENXIO (inferred: macFUSE's kext is closed, but osxfuse's open one revoked a vnode
whose getattr said ENOENT, and a revoked vnode's open gives ENXIO).

On Darwin, for the filesystems that store names as given:
- every path-taking callback resolves its path one component at a time: the NFC form, the name as given, then
  HFS+'s NFD form; a non-ASCII name found by none of them is looked for by scanning its directory, comparing full
  NFC forms, which also match libfuse's ICU NFD of HFS+'s excluded characters (U+2126 as U+03A9). An ASCII miss, the
  usual lookup before a create, never scans. A name on disk is never rewritten;
- with macFUSE 5.5.0-mavericks.5 or later (the version in its manifest, /usr/local/mavergreen/macfuse/mavergreen.plist,
  root's and writable by no one else, as tools/fs.c gates the /dev/fd/N mountpoint), lklfuse gives its libfuse
  -o nonorm_insensitive, which an older one refuses (fuse_new fails). Names then arrive as the kernel's bytes, not
  libfuse's ICU NFD, so the three lookups are all there is: never a directory scan. readdir and readlink then show a
  name in neither NFC nor NFD form as stored, so the bytes sent back for it find it. The mode is said on stderr, the
  mount's log ("lklfuse: names: exact" or "lklfuse: names: scanning"), once fuse_new has taken it: a libfuse that
  refuses the option although its manifest says .5 (a dev build, a manifest out of step with the dylib) gets one
  more fuse_new without it, scanning. With an older macFUSE nothing changes;
- a new entry (create, mknod, mkdir, symlink, link, rename's target) is stored NFC on ext2/3/4, btrfs, xfs, f2fs,
  ntfs3, vfat and exfat (FAT and exFAT as Apple's msdosfs stores them, checked on a FAT32 control), and as given on
  apfs (as macOS does there); an existing entry in another form is used instead, so O_CREAT
  opens it, O_EXCL gives EEXIST and rename replaces it;
- a symlink's target is stored NFC, since Linux resolves it byte for byte;
- readdir and readlink hand names out in HFS+'s NFD (CFStringGetFileSystemRepresentation), or as stored when that
  would be over NAME_MAX;
- like HFS+ (TN1150), both conversions leave U+2000-U+2FFF, U+F900-U+FAFF and U+2F800-U+2FAFF as given, so
  singletons such as U+2126 and U+212B are stored as created (10.9's CoreFoundation would decompose U+2F800-U+2FAFF,
  and NFC would replace the singletons); and U+FEFF is never handed to CoreFoundation at a string's start, where it
  would be dropped as a byte order mark, so a U+FEFF-led name is never taken for its sibling without one.
Other filesystems are unchanged. The conversions are CoreFoundation's (CFStringNormalize), so
lklfuse links it, run by run between the kept characters (all starters, so nothing reorders across them; a kept
character is never composed with the marks after it, so U+2190 U+0338 stays as given, as HFS+ stores it, and the scan's
full-NFC key still finds a Linux-made U+219A). The paths it rewrites are sized by LKL's PATH_MAX (4096), not Darwin's
(1024). lklfuse runs in the foreground on Darwin and never forks after using CoreFoundation. tests/lklfuse-ops-test.c
checks the conversions and each case above on an ext4 image, without a mount.

Darwin only: on Linux the resolver, the stored form and the shown form are the name itself.

diff -ru a/tools/lkl/lklfuse.c b/tools/lkl/lklfuse.c
--- a/tools/lkl/lklfuse.c
+++ b/tools/lkl/lklfuse.c
@@ -10,6 +10,7 @@
 #include <sys/stat.h>
 #include <string.h>
 #include <errno.h>
+#include <limits.h>
 #include <unistd.h>
 #include <pthread.h>
 #include <signal.h>
@@ -136,8 +137,12 @@
 	}
 }
 
+/* LKL's PATH_MAX, for the paths lklfuse rewrites (Darwin's own PATH_MAX is 1024) */
+#define LKLFUSE_PATH_MAX 4096
+
 #ifdef __APPLE__
 #include <sys/xattr.h>
+#include <CoreFoundation/CoreFoundation.h>
 
 #define st_atim st_atimespec
 #define st_mtim st_mtimespec
@@ -267,10 +272,532 @@
 #endif
 	return f;
 }
+
+/*
+ * Unicode names, as HFS+ has them. Mac programs name files in either normalization form (the census, push A, saw
+ * both), macFUSE's libfuse names its nodes NFD and builds every path but a new entry's from those names, and Linux
+ * filesystems store bytes as given, where Linux's own programs write NFC. So:
+ * - new names are stored NFC (NF_STORE_NFC), or as given where macOS itself would (APFS, NF_AS_GIVEN);
+ * - a name is found in any form: each component is tried as NFC, as given, then as HFS+'s NFD, and a non-ASCII
+ *   name found by none of them is looked for by scanning its directory, comparing full NFC forms; a name already on
+ *   disk is never rewritten;
+ * - with macFUSE 5.5.0-mavericks.5 or later, lklfuse gives its libfuse -o nonorm_insensitive, so names arrive as
+ *   the kernel's bytes and the three lookups are all: no scan (lklfuse_nf_exact). readdir then shows a name in
+ *   neither form as stored, so the bytes sent back for it find it;
+ * - like HFS+, the conversions leave U+2000-U+2FFF, U+F900-U+FAFF and U+2F800-U+2FAFF as given, and U+FEFF too;
+ * - readdir and readlink hand names out as HFS+ would (its NFD), unless that is over NAME_MAX.
+ * Without this, a create by NFC landed on disk and then failed with ENXIO: libfuse's next getattr of the new node
+ * came with its NFD path, missed, and macFUSE's kernel side dropped the vnode. CoreFoundation is Apple's own table;
+ * lklfuse never forks once it has used it (on Darwin it runs in the foreground).
+ */
+enum lklfuse_nfmode { NF_OFF, NF_STORE_NFC, NF_AS_GIVEN };
+static enum lklfuse_nfmode lklfuse_nf;
+static unsigned long lklfuse_nf_scans;	/* directory scans, for the tests */
+/*
+ * macFUSE hands names over as the kernel's bytes (its libfuse 3's -o nonorm_insensitive, lklfuse_names_option): a
+ * name is found by exact lookups alone, never by a scan, and readdir shows a name in neither form as stored
+ */
+static int lklfuse_nf_exact;
+
+static enum lklfuse_nfmode lklfuse_nfmode_for(const char *type)
+{
+	static const char *const nfc[] = { "ext4", "ext2", "ext3", "btrfs", "xfs", "f2fs", "ntfs3", "vfat", "exfat" };
+	size_t i;
+
+	if (!type)
+		return NF_OFF;
+	for (i = 0; i < ARRAY_SIZE(nfc); i++)
+		if (strcmp(type, nfc[i]) == 0)
+			return NF_STORE_NFC;
+	return strcmp(type, "apfs") == 0 ? NF_AS_GIVEN : NF_OFF;
+}
+
+static int lklfuse_ascii(const char *s)
+{
+	for (; *s; s++)
+		if (*s & 0x80)
+			return 0;
+	return 1;
+}
+
+/*
+ * The byte length of a code point at C that the conversions keep as it is, or 0:
+ * - U+FEFF, which CoreFoundation drops at the start of a string (it takes it for a byte order mark), always;
+ * - with HFS, the ranges HFS+ never decomposes (TN1150: U+2000-U+2FFF, U+F900-U+FAFF, U+2F800-U+2FAFF). HFS+ stores
+ *   them as given, so NFC keeps them too (U+2126, U+212B and the CJK compatibility ideographs are singletons that
+ *   NFC would replace), and 10.9's CFStringGetFileSystemRepresentation decomposes U+2F800-U+2FAFF, which HFS+ does
+ *   not.
+ * All of them are starters (the range's few combining marks, which have no decompositions, are left in their runs), so
+ * a run between two of them converts on its own and nothing reorders across them. A kept character is also never
+ * composed with the marks after it: U+2190 U+0338 stays as given, where full NFC gives U+219A, as HFS+ stores it.
+ * The scan's key (full NFC) still finds a U+219A made on Linux.
+ */
+static int lklfuse_nf_kept(const char *c, int hfs)
+{
+	const unsigned char *p = (const unsigned char *)c;
+
+	if (p[0] == 0xef && p[1] == 0xbb && p[2] == 0xbf)
+		return 3;
+	if (!hfs)
+		return 0;
+	if (p[0] == 0xe2 && (p[1] & 0xc0) == 0x80 && (p[2] & 0xc0) == 0x80) {
+		unsigned int cp = 0x2000 | (p[1] & 0x3f) << 6 | (p[2] & 0x3f);
+
+		/* the combining marks in the range, none of which decomposes: they stay in their run */
+		if ((cp >= 0x20d0 && cp <= 0x20ff) || (cp >= 0x2cef && cp <= 0x2cf1) || cp == 0x2d7f ||
+		    (cp >= 0x2de0 && cp <= 0x2dff))
+			return 0;
+		return 3;
+	}
+	if (p[0] == 0xef && p[1] >= 0xa4 && p[1] <= 0xab && (p[2] & 0xc0) == 0x80)
+		return 3;
+	if (p[0] == 0xf0 && p[1] == 0xaf && p[2] >= 0xa0 && p[2] <= 0xab && (p[3] & 0xc0) == 0x80)
+		return 4;
+	return 0;
+}
+
+/* CoreFoundation's conversions of IN's first INLEN bytes, into BUF: its length, -1 when it does not fit, -2 for
+ * invalid UTF-8 */
+typedef long (*lklfuse_cf_conv)(const char *in, size_t inlen, char *buf, size_t len);
+
+static long lklfuse_cf_nfc(const char *in, size_t inlen, char *buf, size_t len)
+{
+	CFStringRef s = CFStringCreateWithBytes(NULL, (const UInt8 *)in, inlen, kCFStringEncodingUTF8, false);
+	CFMutableStringRef m;
+	Boolean ok = false;
+
+	if (!s)
+		return -2;
+	m = CFStringCreateMutableCopy(NULL, 0, s);
+	CFRelease(s);
+	if (m) {
+		CFStringNormalize(m, kCFStringNormalizationFormC);
+		ok = CFStringGetCString(m, buf, len, kCFStringEncodingUTF8);
+		CFRelease(m);
+	}
+	return ok ? (long)strlen(buf) : -1;
+}
+
+static long lklfuse_cf_fsrep(const char *in, size_t inlen, char *buf, size_t len)
+{
+	CFStringRef s = CFStringCreateWithBytes(NULL, (const UInt8 *)in, inlen, kCFStringEncodingUTF8, false);
+	Boolean ok;
+
+	if (!s)
+		return -2;
+	ok = CFStringGetFileSystemRepresentation(s, buf, len);
+	CFRelease(s);
+	return ok ? (long)strlen(buf) : -1;
+}
+
+/*
+ * IN converted by CONV run by run, the kept code points copied as they are: IN itself for ASCII, invalid UTF-8 or a
+ * name already in that form; else BUF, or NULL when it does not fit
+ */
+static const char *lklfuse_nf_runs(const char *in, char *buf, size_t len, lklfuse_cf_conv conv, int hfs)
+{
+	const char *p, *q;
+	size_t n = 0;
+	long r;
+	int k = 0;
+
+	if (lklfuse_ascii(in))
+		return in;
+	for (p = in; *p; p = q) {
+		for (q = p; *q && !(k = lklfuse_nf_kept(q, hfs)); q++)
+			;
+		if (q > p) {
+			r = conv(p, q - p, buf + n, len - n);
+			if (r == -2)
+				return in;
+			if (r < 0)
+				return NULL;
+			n += r;
+		}
+		if (*q) {
+			if (n + k >= len)
+				return NULL;
+			memcpy(buf + n, q, k);
+			n += k;
+			q += k;
+		}
+	}
+	if (n >= len)
+		return NULL;
+	buf[n] = '\0';
+	return strcmp(buf, in) == 0 ? in : buf;
+}
+
+/* IN's NFC form, as a new name is stored (HFS+'s excluded ranges as given) */
+static const char *lklfuse_nfc(const char *in, char *buf, size_t len)
+{
+	return lklfuse_nf_runs(in, buf, len, lklfuse_cf_nfc, 1);
+}
+
+/* IN as HFS+ stores it: its NFD variant */
+static const char *lklfuse_nfd_hfs(const char *in, char *buf, size_t len)
+{
+	return lklfuse_nf_runs(in, buf, len, lklfuse_cf_fsrep, 1);
+}
+
+/*
+ * IN's full NFC form, the key two spellings of one name share: libfuse spells a name by ICU's NFD, which does
+ * decompose HFS+'s excluded ranges (U+2126 as U+03A9)
+ */
+static const char *lklfuse_nf_key(const char *in, char *buf, size_t len)
+{
+	return lklfuse_nf_runs(in, buf, len, lklfuse_cf_nfc, 0);
+}
+
+/* the entry of directory DIR whose key is KEY, into OUT: 0, or -ENOENT */
+static int lklfuse_nf_scan(const char *dir, const char *key, char *out, size_t len)
+{
+	char b[LKLFUSE_PATH_MAX];
+	struct lkl_dir *d;
+	struct lkl_linux_dirent64 *de;
+	const char *n;
+	int err, ret = -ENOENT;
+
+	lklfuse_nf_scans++;
+	d = lkl_opendir(*dir ? dir : "/", &err);
+	if (!d)
+		return -ENOENT;
+	while ((de = lkl_readdir(d))) {
+		if (lklfuse_ascii(de->d_name))
+			continue;
+		n = lklfuse_nf_key(de->d_name, b, sizeof(b));
+		if (n && strcmp(n, key) == 0 && strlen(de->d_name) < len) {
+			strcpy(out, de->d_name);
+			ret = 0;
+			break;
+		}
+	}
+	lkl_closedir(d);
+	return ret;
+}
+
+/*
+ * PATH, each component the entry on disk it names in any form, into BUF (*OUT is PATH itself when nothing needs
+ * resolving). A missing last component with CREATE gets the name a new entry is stored under; any other missing one
+ * is left as given, for the call itself to report. 0, or a negative host errno.
+ */
+static int lklfuse_resolve(const char *path, char *buf, size_t len, int create, const char **out)
+{
+	char comp[LKLFUSE_PATH_MAX], nfc[LKLFUSE_PATH_MAX], nfd[LKLFUSE_PATH_MAX], key[LKLFUSE_PATH_MAX];
+	char found[LKLFUSE_PATH_MAX];
+	const char *p, *e, *r, *cand[3], *name, *k;
+	struct lkl_stat st;
+	size_t n = 0, clen;
+	int i, j, last, hit, enoent, missing = 0;
+	long ret;
+
+	*out = path;
+	if (lklfuse_nf == NF_OFF || !path || path[0] != '/' || lklfuse_ascii(path))
+		return 0;
+	buf[0] = '\0';
+	for (p = path; *p; p = e) {
+		while (*p == '/')
+			p++;
+		if (!*p)
+			break;
+		e = strchr(p, '/');
+		if (!e)
+			e = p + strlen(p);
+		clen = e - p;
+		if (clen >= sizeof(comp))
+			return -ENAMETOOLONG;
+		memcpy(comp, p, clen);
+		comp[clen] = '\0';
+		for (r = e; *r == '/'; r++)
+			;
+		last = !*r;
+		name = comp;
+		if (!missing && !lklfuse_ascii(comp)) {
+			cand[0] = lklfuse_nfc(comp, nfc, sizeof(nfc));
+			cand[1] = comp;
+			cand[2] = lklfuse_nfd_hfs(comp, nfd, sizeof(nfd));
+			hit = enoent = 0;
+			for (i = 0; i < 3 && !hit; i++) {
+				if (!cand[i] || n + 1 + strlen(cand[i]) >= len)
+					continue;
+				for (j = 0; j < i; j++)
+					if (cand[j] && strcmp(cand[j], cand[i]) == 0)
+						break;
+				if (j < i)
+					continue;
+				buf[n] = '/';
+				strcpy(buf + n + 1, cand[i]);
+				ret = lkl_sys_lstat(buf, &st);
+				if (ret == 0) {
+					name = cand[i];
+					hit = 1;
+				} else if (ret == -LKL_ENOENT) {
+					enoent = 1;
+				}
+			}
+			buf[n] = '\0';
+			if (!hit && enoent && !lklfuse_nf_exact && (k = lklfuse_nf_key(comp, key, sizeof(key))) &&
+			    lklfuse_nf_scan(buf, k, found, sizeof(found)) == 0) {
+				name = found;
+				hit = 1;
+			}
+			if (!hit) {
+				missing = 1;
+				if (last && create && lklfuse_nf == NF_STORE_NFC) {
+					if (!cand[0])
+						return -ENAMETOOLONG;
+					name = cand[0];
+				}
+			}
+		}
+		if (n + 1 + strlen(name) >= len)
+			return -ENAMETOOLONG;
+		buf[n++] = '/';
+		strcpy(buf + n, name);
+		n += strlen(name);
+	}
+	*out = n ? buf : path;
+	return 0;
+}
+
+/* a name as stored, for a new symlink's target */
+static int lklfuse_nf_store(const char *in, char *buf, size_t len, const char **out)
+{
+	*out = in;
+	if (lklfuse_nf == NF_STORE_NFC && !(*out = lklfuse_nfc(in, buf, len)))
+		return -ENAMETOOLONG;
+	return 0;
+}
+
+/*
+ * IN as handed out, in BUF (LEN bytes): HFS+'s form, or IN as stored when that does not fit, or, with names exact,
+ * when IN is in neither NFC nor NFD form. The kernel then sends back bytes the resolver's exact lookups find: NFC
+ * finds a name stored NFC from its NFD, and a name in neither form is found only by its own bytes.
+ */
+static const char *lklfuse_nf_shown(const char *in, char *buf, size_t len)
+{
+	char nfc[LKLFUSE_PATH_MAX];
+	const char *s;
+
+	if (lklfuse_nf == NF_OFF)
+		return in;
+	s = lklfuse_nfd_hfs(in, buf, len);
+	if (!s || s == in)
+		return in;
+	if (lklfuse_nf_exact && lklfuse_nfc(in, nfc, sizeof(nfc)) != in)
+		return in;
+	return s;
+}
+
+/* a symlink's target as handed out, in place in BUF (LEN bytes), as lklfuse_nf_shown hands out a name */
+static void lklfuse_nf_show_target(char *buf, size_t len)
+{
+	char shown[LKLFUSE_PATH_MAX];
+	const char *s = lklfuse_nf_shown(buf, shown, len < sizeof(shown) ? len : sizeof(shown));
+
+	if (s != buf)
+		strcpy(buf, s);
+}
+
+/*
+ * Mavergreen macFUSE's libfuse 3 names its nodes by ICU's NFD unless it is given -o nonorm_insensitive, from
+ * 5.5.0-mavericks.5 on (macfuse's DETAILS.md, "File names: normalized unless you ask"); an older one refuses the
+ * option, and fuse_new fails. So the option is given only when the installed macFUSE's manifest names that release
+ * or a later one, as linuxfs's mount program gates the /dev/fd/N mountpoint (tools/fs.c, MACFUSE_FD_MOUNTPOINT_SINCE).
+ */
+#define LKLFUSE_MACFUSE_MANIFEST "/usr/local/mavergreen/macfuse/mavergreen.plist"
+#define LKLFUSE_NAMES_EXACT_SINCE "5.5.0-mavericks.5"
+
+/* a Mavergreen macFUSE version, A.B.C-mavericks.N, into V: 0, or -1 when S is not one */
+static int lklfuse_macfuse_version(const char *s, unsigned int v[4])
+{
+	static const char *const sep[] = { ".", ".", "-mavericks.", "" };
+	int i, digits;
+
+	for (i = 0; i < 4; i++) {
+		v[i] = 0;
+		for (digits = 0; *s >= '0' && *s <= '9' && digits < 9; digits++)
+			v[i] = v[i] * 10 + (unsigned int)(*s++ - '0');
+		if (!digits || strncmp(s, sep[i], strlen(sep[i])) != 0)
+			return -1;
+		s += strlen(sep[i]);
+	}
+	return *s ? -1 : 0;
+}
+
+/*
+ * Whether the macFUSE manifest at PATH names LKLFUSE_NAMES_EXACT_SINCE or later: 1, or 0 when it does not, or is
+ * missing, unreadable, a symlink, not a regular file, not OWNER's or writable by anyone else. Its version into VER
+ * (LEN bytes), or "" when it has none.
+ */
+static int lklfuse_macfuse_exact(const char *path, uid_t owner, char *ver, size_t len)
+{
+	char data[65536];
+	struct stat st;
+	CFDataRef d;
+	CFPropertyListRef pl = NULL;
+	CFTypeRef v;
+	unsigned int have[4], need[4];
+	ssize_t n = -1;
+	int fd, i, ok = 0;
+
+	ver[0] = '\0';
+	fd = open(path, O_RDONLY | O_NOFOLLOW | O_CLOEXEC);
+	if (fd < 0)
+		return 0;
+	if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_uid == owner && !(st.st_mode & (S_IWGRP | S_IWOTH)) &&
+	    st.st_size < (off_t)sizeof(data))
+		n = read(fd, data, sizeof(data));
+	close(fd);
+	if (n <= 0)
+		return 0;
+	d = CFDataCreate(NULL, (const UInt8 *)data, n);
+	if (d) {
+		pl = CFPropertyListCreateWithData(NULL, d, kCFPropertyListImmutable, NULL, NULL);
+		CFRelease(d);
+	}
+	if (!pl)
+		return 0;
+	v = CFGetTypeID(pl) == CFDictionaryGetTypeID() ? CFDictionaryGetValue(pl, CFSTR("version")) : NULL;
+	if (!v || CFGetTypeID(v) != CFStringGetTypeID() || !CFStringGetCString(v, ver, len, kCFStringEncodingUTF8))
+		ver[0] = '\0';
+	if (lklfuse_macfuse_version(ver, have) == 0 && lklfuse_macfuse_version(LKLFUSE_NAMES_EXACT_SINCE, need) == 0) {
+		ok = 1;
+		for (i = 0; i < 4; i++)
+			if (have[i] != need[i]) {
+				ok = have[i] > need[i];
+				break;
+			}
+	}
+	CFRelease(pl);
+	return ok;
+}
+
+static char lklfuse_macfuse_ver[64];	/* the installed macFUSE's version, for the names line */
+
+/* The names mode, from the macFUSE manifest at PATH (OWNER's), set in lklfuse_nf_exact: the option to hand libfuse, or NULL */
+static const char *lklfuse_names_option(const char *path, uid_t owner)
+{
+	lklfuse_nf_exact = lklfuse_macfuse_exact(path, owner, lklfuse_macfuse_ver, sizeof(lklfuse_macfuse_ver));
+	return lklfuse_nf_exact ? "-ononorm_insensitive" : NULL;
+}
+
+/* the names mode running, said on stderr (the mount's log) */
+static void lklfuse_names_say(void)
+{
+	const char *ver = lklfuse_macfuse_ver[0] ? lklfuse_macfuse_ver : "(no readable version)";
