+/*
+ * Unicode names, as HFS+ has them. Mac programs name files in either normalization form (the census, push A, saw
+ * both), macFUSE's libfuse names its nodes NFD and builds every path but a new entry's from those names, and Linux
+ * filesystems store bytes as given, where Linux's own programs write NFC. So:
+ * - new names are stored NFC (NF_STORE_NFC), or as given where macOS itself would (APFS, NF_AS_GIVEN);
+ * - a name is found in any form: each component is tried as NFC, as given, then as HFS+'s NFD, and a non-ASCII
+ *   name found by none of them is looked for by scanning its directory, comparing NFC forms; a name already on disk
+ *   is never rewritten;
+ * - readdir and readlink hand names out as HFS+ would (its NFD, which leaves U+2000-U+2FFF, U+F900-U+FAFF and
+ *   U+2F800-U+2FAFF composed), unless that is over NAME_MAX.
+ * Without this, a create by NFC landed on disk and then failed with ENXIO: libfuse's next getattr of the new node
+ * came with its NFD path, missed, and macFUSE's kernel side dropped the vnode. CoreFoundation is Apple's own table;
+ * lklfuse never forks once it has used it (on Darwin it runs in the foreground).
+ */
+enum lklfuse_nfmode { NF_OFF, NF_STORE_NFC, NF_AS_GIVEN };
+static enum lklfuse_nfmode lklfuse_nf;
+static unsigned long lklfuse_nf_scans;	/* directory scans, for the tests */
+
+static enum lklfuse_nfmode lklfuse_nfmode_for(const char *type)
+{
+	static const char *const nfc[] = { "ext4", "ext2", "ext3", "btrfs", "xfs", "f2fs", "ntfs3" };
+	size_t i;
+
+	if (!type)
+		return NF_OFF;
+	for (i = 0; i < ARRAY_SIZE(nfc); i++)
+		if (strcmp(type, nfc[i]) == 0)
+			return NF_STORE_NFC;
+	return strcmp(type, "apfs") == 0 ? NF_AS_GIVEN : NF_OFF;
+}
+
+static int lklfuse_ascii(const char *s)
+{
+	for (; *s; s++)
+		if (*s & 0x80)
+			return 0;
+	return 1;
+}
+
+/* NULL for invalid UTF-8 */
+static CFStringRef lklfuse_cfstring(const char *in)
+{
+	return CFStringCreateWithBytes(NULL, (const UInt8 *)in, strlen(in), kCFStringEncodingUTF8, false);
+}
+
+/* IN's NFC form: IN itself for ASCII, invalid UTF-8 or a name already NFC; else BUF, or NULL when it does not fit */
+static const char *lklfuse_nfc(const char *in, char *buf, size_t len)
+{
+	CFStringRef s;
+	CFMutableStringRef m;
+	Boolean ok = false;
+
+	if (lklfuse_ascii(in) || !(s = lklfuse_cfstring(in)))
+		return in;
+	m = CFStringCreateMutableCopy(NULL, 0, s);
+	CFRelease(s);
+	if (m) {
+		CFStringNormalize(m, kCFStringNormalizationFormC);
+		ok = CFStringGetCString(m, buf, len, kCFStringEncodingUTF8);
+		CFRelease(m);
+	}
+	if (!ok)
+		return NULL;
+	return strcmp(buf, in) == 0 ? in : buf;
+}
+
+/* CoreFoundation's file system form of IN's first INLEN bytes, into BUF: its length, -1 when it does not fit, -2 for
+ * invalid UTF-8 */
+static long lklfuse_cf_fsrep(const char *in, size_t inlen, char *buf, size_t len)
+{
+	CFStringRef s = CFStringCreateWithBytes(NULL, (const UInt8 *)in, inlen, kCFStringEncodingUTF8, false);
+	Boolean ok;
+
+	if (!s)
+		return -2;
+	ok = CFStringGetFileSystemRepresentation(s, buf, len);
+	CFRelease(s);
+	return ok ? (long)strlen(buf) : -1;
+}
+
+/* U+2F800-U+2FAFF: HFS+ leaves them composed, and 10.9's CFStringGetFileSystemRepresentation does not */
+static int lklfuse_hfs_kept(const char *c)
+{
+	const unsigned char *p = (const unsigned char *)c;
+
+	return p[0] == 0xf0 && p[1] == 0xaf && p[2] >= 0xa0 && p[2] <= 0xab && (p[3] & 0xc0) == 0x80;
+}
+
+/* IN as HFS+ stores it (its NFD variant), with lklfuse_nfc's results */
+static const char *lklfuse_nfd_hfs(const char *in, char *buf, size_t len)
+{
+	const char *p, *q;
+	size_t n = 0;
+	long r;
+
+	if (lklfuse_ascii(in))
+		return in;
+	/* each run between two kept characters on its own: they are starters, so nothing reorders across them */
+	for (p = in; *p; p = q) {
+		for (q = p; *q && !lklfuse_hfs_kept(q); q++)
+			;
+		if (q > p) {
+			r = lklfuse_cf_fsrep(p, q - p, buf + n, len - n);
+			if (r == -2)
+				return in;
+			if (r < 0)
+				return NULL;
+			n += r;
+		}
+		if (*q) {
+			if (n + 4 >= len)
+				return NULL;
+			memcpy(buf + n, q, 4);
+			n += 4;
+			q += 4;
+		}
+	}
+	if (n >= len)
+		return NULL;
+	buf[n] = '\0';
+	return strcmp(buf, in) == 0 ? in : buf;
+}
+
+/* the entry of directory DIR whose NFC form is NFC, into OUT: 0, or -ENOENT */
+static int lklfuse_nf_scan(const char *dir, const char *nfc, char *out, size_t len)
+{
+	char b[PATH_MAX];
+	struct lkl_dir *d;
+	struct lkl_linux_dirent64 *de;
+	const char *n;
+	int err, ret = -ENOENT;
+
+	lklfuse_nf_scans++;
+	d = lkl_opendir(*dir ? dir : "/", &err);
+	if (!d)
+		return -ENOENT;
+	while ((de = lkl_readdir(d))) {
+		if (lklfuse_ascii(de->d_name))
+			continue;
+		n = lklfuse_nfc(de->d_name, b, sizeof(b));
+		if (n && strcmp(n, nfc) == 0 && strlen(de->d_name) < len) {
+			strcpy(out, de->d_name);
+			ret = 0;
+			break;
+		}
+	}
+	lkl_closedir(d);
+	return ret;
+}
+
+/*
+ * PATH, each component the entry on disk it names in any form, into BUF (*OUT is PATH itself when nothing needs
+ * resolving). A missing last component with CREATE gets the name a new entry is stored under; any other missing one
+ * is left as given, for the call itself to report. 0, or a negative host errno.
+ */
+static int lklfuse_resolve(const char *path, char *buf, size_t len, int create, const char **out)
+{
+	char comp[PATH_MAX], nfc[PATH_MAX], nfd[PATH_MAX], found[PATH_MAX];
+	const char *p, *e, *r, *cand[3], *name;
+	struct lkl_stat st;
+	size_t n = 0, clen;
+	int i, j, last, hit, enoent, missing = 0;
+	long ret;
+
+	*out = path;
+	if (lklfuse_nf == NF_OFF || !path || path[0] != '/' || lklfuse_ascii(path))
+		return 0;
+	buf[0] = '\0';
+	for (p = path; *p; p = e) {
+		while (*p == '/')
+			p++;
+		if (!*p)
+			break;
+		e = strchr(p, '/');
+		if (!e)
+			e = p + strlen(p);
+		clen = e - p;
+		if (clen >= sizeof(comp))
+			return -ENAMETOOLONG;
+		memcpy(comp, p, clen);
+		comp[clen] = '\0';
+		for (r = e; *r == '/'; r++)
+			;
+		last = !*r;
+		name = comp;
+		if (!missing && !lklfuse_ascii(comp)) {
+			cand[0] = lklfuse_nfc(comp, nfc, sizeof(nfc));
+			cand[1] = comp;
+			cand[2] = lklfuse_nfd_hfs(comp, nfd, sizeof(nfd));
+			hit = enoent = 0;
+			for (i = 0; i < 3 && !hit; i++) {
+				if (!cand[i] || n + 1 + strlen(cand[i]) >= len)
+					continue;
+				for (j = 0; j < i; j++)
+					if (cand[j] && strcmp(cand[j], cand[i]) == 0)
+						break;
+				if (j < i)
+					continue;
+				buf[n] = '/';
+				strcpy(buf + n + 1, cand[i]);
+				ret = lkl_sys_lstat(buf, &st);
+				if (ret == 0) {
+					name = cand[i];
+					hit = 1;
+				} else if (ret == -LKL_ENOENT) {
+					enoent = 1;
+				}
+			}
+			buf[n] = '\0';
+			if (!hit && enoent && cand[0] &&
+			    lklfuse_nf_scan(buf, cand[0], found, sizeof(found)) == 0) {
+				name = found;
+				hit = 1;
+			}
+			if (!hit) {
+				missing = 1;
+				if (last && create && lklfuse_nf == NF_STORE_NFC) {
+					if (!cand[0])
+						return -ENAMETOOLONG;
+					name = cand[0];
+				}
+			}
+		}
+		if (n + 1 + strlen(name) >= len)
+			return -ENAMETOOLONG;
+		buf[n++] = '/';
+		strcpy(buf + n, name);
+		n += strlen(name);
+	}
+	*out = n ? buf : path;
+	return 0;
+}
+
+/* a name as stored, for a new symlink's target */
+static int lklfuse_nf_store(const char *in, char *buf, size_t len, const char **out)
+{
+	*out = in;
+	if (lklfuse_nf == NF_STORE_NFC && !(*out = lklfuse_nfc(in, buf, len)))
+		return -ENAMETOOLONG;
+	return 0;
+}
+
+/* a symlink's target as handed out, in place in BUF (LEN bytes): HFS+'s form, or as stored when that does not fit */
+static void lklfuse_nf_show_target(char *buf, size_t len)
+{
+	char shown[PATH_MAX];
+	const char *s;
+
+	if (lklfuse_nf == NF_OFF)
+		return;
+	s = lklfuse_nfd_hfs(buf, shown, len < sizeof(shown) ? len : sizeof(shown));
+	if (s && s != buf)
+		strcpy(buf, s);
+}
+
+/* a name as handed out: HFS+'s form, or as stored when that does not fit */
+static const char *lklfuse_nf_shown(const char *in, char *buf, size_t len)
+{
+	const char *s;
+
+	if (lklfuse_nf == NF_OFF)
+		return in;
+	s = lklfuse_nfd_hfs(in, buf, len);
+	return s ? s : in;
+}
 #else
 #define lklfuse_err(ret) (ret)
 #define lklfuse_xattr_flags(flags) (flags)
 #define lklfuse_rename_flags(flags) (flags)
+
+static inline int lklfuse_resolve(const char *path, char *buf, size_t len, int create, const char **out)
+{
+	*out = path;
+	return 0;
+}
+
+static inline int lklfuse_nf_store(const char *in, char *buf, size_t len, const char **out)
+{
+	*out = in;
+	return 0;
+}
+
+static inline void lklfuse_nf_show_target(char *buf, size_t len)
+{
+}
+
+static inline const char *lklfuse_nf_shown(const char *in, char *buf, size_t len)
+{
+	return in;
+}
