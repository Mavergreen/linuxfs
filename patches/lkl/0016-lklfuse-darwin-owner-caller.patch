+/*
+ * The ids the new node at PATH takes, into *uid and *gid: owner='s, or with owner=caller the FUSE request's uid and the
+ * group of the directory PATH is in (BSD's rule, as on HFS+; it also keeps a Linux setgid directory's group). 0 when
+ * none (no owner=, no request to take them from, or the directory gone): the node keeps LKL's own.
+ */
+static int lklfuse_owner_ids(const char *path, unsigned int *uid, unsigned int *gid)
+{
+#ifdef __APPLE__
+	if (lklfuse.set_owner == 2) {
+		struct fuse_context *c = fuse_get_context();
+		char dir[LKLFUSE_PATH_MAX];
+		const char *slash = strrchr(path, '/');
+		struct lkl_stat st;
+		size_t n;
+
+		if (!c || !slash)
+			return 0;
+		n = slash == path ? 1 : (size_t)(slash - path);
+		if (n >= sizeof(dir))
+			return 0;
+		memcpy(dir, path, n);
+		dir[n] = '\0';
+		if (lkl_sys_newfstatat(LKL_AT_FDCWD, dir, &st, 0) < 0)
+			return 0;
+		*uid = c->uid;
+		*gid = st.st_gid;
+		return 1;
+	}
+#else
+	(void)path;
+#endif
+	*uid = lklfuse.owner_uid;
+	*gid = lklfuse.owner_gid;
+	return lklfuse.set_owner;
+}
+
+/*
+ * Chown the node just made at PATH (mkdir, mknod, symlink: no descriptor to chown by), and only it: the name is opened
+ * O_PATH|O_NOFOLLOW and chowned through that descriptor only when it is LKL's (uid 0, as every node LKL makes) and,
+ * unless a directory, its only link. lklfuse serves one request at a time (0009: fuse_loop, no multithreaded mode), so
+ * nothing can put another file under the name between its making and this; the check keeps that true if that changes
+ * (a hard link to someone's file raced into the name would otherwise be chowned to the caller). 1 when chowned.
+ */
+static int lklfuse_chown_new(const char *path, unsigned int uid, unsigned int gid)
+{
+	struct lkl_stat st;
+	long fd = lkl_sys_openat(LKL_AT_FDCWD, path, LKL_O_PATH | LKL_O_NOFOLLOW | LKL_O_CLOEXEC, 0);
+	int ok;
+
+	if (fd < 0)
+		return 0;
+	ok = lkl_sys_newfstatat(fd, "", &st, LKL_AT_EMPTY_PATH) == 0 && st.st_uid == 0 &&
+	     (LKL_S_ISDIR(st.st_mode) || st.st_nlink == 1) &&
+	     lkl_sys_fchownat(fd, "", uid, gid, LKL_AT_EMPTY_PATH) == 0;
+	lkl_sys_close(fd);
+	return ok;
+}
+
 static int lklfuse_own(const char *path, long ret)
 {
-	if (ret == 0 && lklfuse.set_owner)
-		lkl_sys_fchownat(LKL_AT_FDCWD, path, lklfuse.owner_uid,
-				 lklfuse.owner_gid, LKL_AT_SYMLINK_NOFOLLOW);
+	unsigned int uid, gid;
+
+	if (ret == 0 && lklfuse_owner_ids(path, &uid, &gid))
+		lklfuse_chown_new(path, uid, gid);
 	return lklfuse_err(ret);
 }
 
@@ -1101,6 +1171,7 @@
 	char pbuf[LKLFUSE_PATH_MAX];
 	int flags = fi->flags;
 	int ret, tries;
+	unsigned int uid, gid;
 
 	/* an existing entry in any form is opened (EEXIST with O_EXCL); only a new one gets the stored form */
 	if ((ret = lklfuse_resolve(path, pbuf, sizeof(pbuf), 1, &path)))
@@ -1127,7 +1198,8 @@
 	}
 	if (tries == 4 && (ret = lklfuse_open3(path, true, mode, fi)) != 0)
 		return ret;
-	lkl_sys_fchown(fi->fh, lklfuse.owner_uid, lklfuse.owner_gid);
+	if (lklfuse_owner_ids(path, &uid, &gid))
+		lkl_sys_fchown(fi->fh, uid, gid);
 	return 0;
 }
 
