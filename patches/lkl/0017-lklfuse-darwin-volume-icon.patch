+/*
+ * A write-open of the icon without O_TRUNC edits it in place (or only takes a lock): the real file made under the name
+ * starts as the icon's bytes, so what was read through stat a moment before is still there. O_EXCL makes only a new
+ * file; one made meanwhile by someone else is opened as it is, never overwritten. A copy that fails is undone.
+ */
+static int lklfuse_volicon_copyup(const char *path, struct fuse_file_info *fi)
+{
+	char buf[16384];
+	int flags = fi->flags, ret, n, w;
+	long r;
+	off_t off = 0;
+
+	fi->flags = flags | O_CREAT | O_EXCL;
+	ret = lklfuse_create(path, 0644, fi);	/* owner= as any new file */
+	fi->flags = flags;
+	if (ret == -EEXIST) {
+		char pbuf[LKLFUSE_PATH_MAX];
+
+		ret = lklfuse_resolve(path, pbuf, sizeof(pbuf), 0, &path);
+		return ret ? ret : lklfuse_open3(path, false, 0, fi);
+	}
+	if (ret)
+		return ret;
+	while ((n = lklfuse_volicon_read(buf, sizeof(buf), off)) > 0) {
+		for (w = 0; w < n; w += r)
+			if ((r = lkl_sys_pwrite64(fi->fh, buf + w, n - w, off + w)) <= 0)
+				goto undo;
+		off += n;
+	}
+	if (n == 0)
+		return 0;
+	r = n;
+undo:
+	lkl_sys_close(fi->fh);
+	lklfuse_unlink(path);
+	return n < 0 ? n : r < 0 ? lklfuse_err(r) : -EIO;
+}
+
 static int lklfuse_open(const char *path, struct fuse_file_info *fi)
 {
 	char pbuf[LKLFUSE_PATH_MAX];
-	int ret = lklfuse_resolve(path, pbuf, sizeof(pbuf), 0, &path);
+	int ret;
 
+	if (lklfuse_volicon_is(path)) {
+		/* the kernel sees a file, so cp's O_CREAT reaches here as an open: the user's own icon, made as create makes one */
+		if (fi->flags & O_TRUNC)
+			return lklfuse_create(path, 0644, fi);
+		if ((fi->flags & O_ACCMODE) != O_RDONLY)
+			return lklfuse_volicon_copyup(path, fi);
+		fi->fh = LKLFUSE_VOLICON_FH;
+		return 0;
+	}
+	ret = lklfuse_resolve(path, pbuf, sizeof(pbuf), 0, &path);
 	return ret ? ret : lklfuse_open3(path, false, 0, fi);
 }
 
