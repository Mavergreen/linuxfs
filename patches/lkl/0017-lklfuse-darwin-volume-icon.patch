+/*
+ * The volume icon (-o volicon=PATH, Darwin's option; linuxfs passes its bundle's linuxfs.icns, made at install). A volume
+ * whose root has no /.VolumeIcon.icns of its own shows that icon, as a Mac volume shows its own: lookup and getattr of
+ * /.VolumeIcon.icns answer a regular file (0644, the root's owner and group, so mapped as every other file; PATH's
+ * size and times) whose reads are PATH's bytes, and the root's com.apple.FinderInfo says it has a custom icon
+ * (kHasCustomIcon). readdir does not list it, and lklfuse itself never writes anything to the disk. Its bytes and
+ * attributes cannot be changed, nor can it be moved or linked (EACCES); unlinking it gives ENOENT, as nothing of that
+ * name is on the disk. But a user may put their own icon there, as on HFS+: making a file under the name (create, an
+ * open with O_TRUNC, truncate, rename or link onto it, mkdir, mknod, symlink) acts on the disk as if the name were
+ * free, so a real /.VolumeIcon.icns is made; an open for writing without O_TRUNC makes it a copy of the icon's bytes.
+ * A real one wins: it is looked for on every call (lookups are not cached, lklfuse_init), so one made or removed shows
+ * at once. The code is portable; elsewhere nothing sets volicon, so there is never an icon.
+ */
+#define LKLFUSE_VOLICON "/.VolumeIcon.icns"
+#define LKLFUSE_VOLICON_FH ((uint64_t)-2)	/* the open icon's fh: never an LKL descriptor */
+#define LKLFUSE_VOLICON_INO 0xfffffffffffffff0ULL	/* past every filesystem's inode numbers (btrfs's end at -256) */
+#define LKLFUSE_HAS_CUSTOM_ICON 0x0400	/* kHasCustomIcon, in the FolderInfo's frFlags (bytes 8-9, big-endian) */
+static int lklfuse_volicon_fd = -1;
+static struct stat lklfuse_volicon_st;
+
+/* opens PATH, once, at start: 0 (also with no volicon=); -1, said, and no icon when it is not a readable regular file */
+static int lklfuse_volicon_open(void)
+{
+	int fd;
+
+	if (!lklfuse.volicon)
+		return 0;
+	fd = open(lklfuse.volicon, O_RDONLY | O_CLOEXEC);
+	if (fd < 0 || fstat(fd, &lklfuse_volicon_st) || !S_ISREG(lklfuse_volicon_st.st_mode)) {
+		fprintf(stderr, "lklfuse: volicon=%s: %s; the volume shows no icon of its own\n", lklfuse.volicon,
+			fd < 0 ? strerror(errno) : "not a regular file");
+		if (fd >= 0)
+			close(fd);
+		return -1;
+	}
+	lklfuse_volicon_fd = fd;
+	return 0;
+}
+
+/* the icon is shown now: there is one, and the volume has no /.VolumeIcon.icns of its own */
+static int lklfuse_volicon_on(void)
+{
+	struct lkl_stat st;
+
+	return lklfuse_volicon_fd >= 0 && lkl_sys_lstat(LKLFUSE_VOLICON, &st) == -LKL_ENOENT;
+}
+
+/* PATH (a FUSE path, or NULL) is the icon lklfuse shows */
+static int lklfuse_volicon_is(const char *path)
+{
+	return path && strcmp(path, LKLFUSE_VOLICON) == 0 && lklfuse_volicon_on();
+}
+
+/* FI is the icon, opened */
+static int lklfuse_volicon_fi(const struct fuse_file_info *fi)
+{
+	return fi && fi->fh == LKLFUSE_VOLICON_FH;
+}
+
+static int lklfuse_volicon_stat(struct stat *st)
+{
+	struct lkl_stat root;
+	long ret = lkl_sys_lstat("/", &root);
+
+	if (ret)
+		return lklfuse_err(ret);
+	lklfuse_xlat_stat(&root, st);
+	st->st_ino = LKLFUSE_VOLICON_INO;
+	st->st_mode = S_IFREG | 0644;
+	st->st_nlink = 1;
+	st->st_rdev = 0;
+	st->st_size = lklfuse_volicon_st.st_size;
+	st->st_blocks = (lklfuse_volicon_st.st_size + 511) / 512;
+	st->st_atim = lklfuse_volicon_st.st_atim;
+	st->st_mtim = lklfuse_volicon_st.st_mtim;
+	st->st_ctim = lklfuse_volicon_st.st_ctim;
+	return 0;
+}
+
+static int lklfuse_volicon_read(char *buf, size_t size, off_t off)
+{
+	size_t got = 0;
+	ssize_t n;
+
+	while (got < size) {
+		n = pread(lklfuse_volicon_fd, buf + got, size - got, off + got);
+		if (n < 0 && errno == EINTR)
+			continue;
+		if (n < 0)
+			return -errno;
+		if (n == 0)
+			break;
+		got += n;
+	}
+	return got;
+}
+
+/*
+ * the root's FinderInfo while the icon is shown: the volume's own (Mac xattrs, patch 0013), or a FolderInfo of zeros
+ * when it has none, with kHasCustomIcon set; the flag is never written
+ */
+static int lklfuse_volicon_finderinfo(char *val, size_t size)
+{
+	char fi[LKLFUSE_FINDERINFO_LEN];
+
+	if (size == 0)
+		return LKLFUSE_FINDERINFO_LEN;
+	if (size < LKLFUSE_FINDERINFO_LEN)
+		return -ERANGE;
+	if (lklfuse_xget("/", LKLFUSE_FINDERINFO, fi, sizeof(fi)) != LKLFUSE_FINDERINFO_LEN)
+		memset(fi, 0, sizeof(fi));
+	fi[8] |= LKLFUSE_HAS_CUSTOM_ICON >> 8;
+	fi[9] |= LKLFUSE_HAS_CUSTOM_ICON & 0xff;
+	memcpy(val, fi, sizeof(fi));
+	return LKLFUSE_FINDERINFO_LEN;
+}
+
+/* the root's listxattr while the icon is shown: the volume's own names, and com.apple.FinderInfo once */
+static int lklfuse_volicon_listxattr(char *list, size_t size)
+{
+	int n = lklfuse_xlist("/", NULL, 0), off, has = 0;
+	char *own;
+
+	if (n == -ENOTSUP)
+		n = 0;
+	if (n < 0)
+		return n;
+	own = malloc(n + sizeof(LKLFUSE_FINDERINFO));
+	if (!own)
+		return -ENOMEM;
+	if (n > 0)
+		n = lklfuse_xlist("/", own, n);
+	for (off = 0; off < n; off += strlen(own + off) + 1)
+		has |= strcmp(own + off, LKLFUSE_FINDERINFO) == 0;
+	if (n >= 0 && !has) {
+		memcpy(own + n, LKLFUSE_FINDERINFO, sizeof(LKLFUSE_FINDERINFO));
+		n += sizeof(LKLFUSE_FINDERINFO);
+	}
+	if (n >= 0 && size && (size_t)n > size)
+		n = -ERANGE;
+	else if (n > 0 && size)
+		memcpy(list, own, n);
+	free(own);
+	return n;
+}
