+/* Darwin's XATTR_CREATE and XATTR_REPLACE are 2 and 4; Linux's are 1 and 2. */
+static int lklfuse_xattr_flags(int flags)
+{
+	return ((flags & XATTR_CREATE) ? 1 : 0) | ((flags & XATTR_REPLACE) ? 2 : 0);
+}
+
+/* macFUSE passes Darwin's RENAME_EXCL and RENAME_SWAP. */
+static unsigned int lklfuse_rename_flags(unsigned int flags)
+{
+	unsigned int f = 0;
+
+#ifdef RENAME_EXCL
+	if (flags & RENAME_EXCL)
+		f |= LKL_RENAME_NOREPLACE;
+#endif
+#ifdef RENAME_SWAP
+	if (flags & RENAME_SWAP)
+		f |= LKL_RENAME_EXCHANGE;
+#endif
+	return f;
+}
+#else
+#define lklfuse_err(ret) (ret)
+#define lklfuse_xattr_flags(flags) (flags)
+#define lklfuse_rename_flags(flags) (flags)
+#endif
