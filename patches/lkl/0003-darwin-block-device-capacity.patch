+	/* Darwin's lseek() and fstat() report 0 for a disk; ask its driver. */
+	if (fstat(disk.fd, &st) == 0 && (S_ISBLK(st.st_mode) || S_ISCHR(st.st_mode))) {
+		if (ioctl(disk.fd, DKIOCGETBLOCKSIZE, &block_size) < 0 ||
+		    ioctl(disk.fd, DKIOCGETBLOCKCOUNT, &blocks) < 0)
+			return -1;
