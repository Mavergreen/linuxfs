+/*
+ * close-on-exec, so the mount helper that libfuse runs does not inherit the image. /dev/fd/N is a descriptor
+ * this process was started with (linuxfs-open passes the helper's on fd 3): used as it is, and made
+ * close-on-exec too.
+ */
+static int lklfuse_open_disk(void)
+{
+	int fd;
+	char extra;
+
+	if (sscanf(lklfuse.file, "/dev/fd/%d%c", &fd, &extra) == 1 && fd >= 0 && fcntl(fd, F_GETFD) >= 0) {
+		fcntl(fd, F_SETFD, FD_CLOEXEC);
+		return fd;
+	}
+	return open(lklfuse.file, (lklfuse.ro ? O_RDONLY : O_RDWR) | O_CLOEXEC);
+}
+
 int main(int argc, char **argv)
 {
