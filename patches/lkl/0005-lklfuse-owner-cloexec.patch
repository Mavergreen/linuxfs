+/*
+ * owner=: new files take the filesystem root's ids (owner=root) or given ones (owner=UID:GID), not
+ * LKL's own (0:0). A filesystem that cannot hold the ids (vfat) keeps its own; that is not an error.
+ */
+static int lklfuse_set_owner(void)
+{
+	struct lkl_stat st;
+	unsigned int uid, gid;
+	char extra;
+	long ret;
+
+	lklfuse.set_owner = 0;
+	if (!lklfuse.owner)
+		return 0;
+	if (strcmp(lklfuse.owner, "root") == 0) {
+		ret = lkl_sys_newfstatat(LKL_AT_FDCWD, "/", &st, 0);
+		if (ret < 0)
+			return lklfuse_err(ret);
+		uid = st.st_uid;
+		gid = st.st_gid;
+	} else if (sscanf(lklfuse.owner, "%u:%u%c", &uid, &gid, &extra) != 2) {
+		fprintf(stderr, "owner=%s: not root or UID:GID\n", lklfuse.owner);
+		return -EINVAL;
+	}
+	lklfuse.owner_uid = uid;
+	lklfuse.owner_gid = gid;
+	lklfuse.set_owner = 1;
+	return 0;
+}
+
+static int lklfuse_own(const char *path, long ret)
+{
+	if (ret == 0 && lklfuse.set_owner)
+		lkl_sys_fchownat(LKL_AT_FDCWD, path, lklfuse.owner_uid,
+				 lklfuse.owner_gid, LKL_AT_SYMLINK_NOFOLLOW);
+	return lklfuse_err(ret);
+}
+
 static int lklfuse_mknod(const char *path, mode_t mode, dev_t dev)
 {
-	return lklfuse_err(lkl_sys_mknod(path, mode, dev));
+	return lklfuse_own(path, lkl_sys_mknod(path, mode, dev));
 }
 
 static int lklfuse_mkdir(const char *path, mode_t mode)
 {
-	return lklfuse_err(lkl_sys_mkdir(path, mode));
+	return lklfuse_own(path, lkl_sys_mkdir(path, mode));
 }
 
 static int lklfuse_unlink(const char *path)
