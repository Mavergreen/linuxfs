@@ -467,7 +513,33 @@
 static int lklfuse_create(const char *path, mode_t mode,
 	                  struct fuse_file_info *fi)
 {
-	return lklfuse_open3(path, true, mode, fi);
+	int flags = fi->flags;
+	int ret, tries;
+
+	if (!lklfuse.set_owner)
+		return lklfuse_open3(path, true, mode, fi);
+	/*
+	 * Only a file this call creates takes owner=; O_EXCL tells the two apart. When the name exists, it is
+	 * opened as it is. When it then is gone again (unlinked meanwhile), creating is tried again, so a file
+	 * made in that gap is still chowned. A name O_EXCL finds and a plain open does not, every time, is a
+	 * dangling symlink: create makes its target, which this call has just seen absent, so chown that too.
+	 */
+	for (tries = 0; tries < 4; tries++) {
+		fi->flags = flags | O_EXCL;
+		ret = lklfuse_open3(path, true, mode, fi);
+		fi->flags = flags;
+		if (ret == 0)
+			break;
+		if (ret != -EEXIST || (flags & O_EXCL))
+			return ret;
+		ret = lklfuse_open3(path, false, mode, fi);
+		if (ret != -ENOENT)
+			return ret;
+	}
+	if (tries == 4 && (ret = lklfuse_open3(path, true, mode, fi)) != 0)
+		return ret;
+	lkl_sys_fchown(fi->fh, lklfuse.owner_uid, lklfuse.owner_gid);
+	return 0;
 }
 
 static int lklfuse_open(const char *path, struct fuse_file_info *fi)
