+/*
+ * An encrypted volume's password: read from passfd (to its end; one trailing newline dropped) and given to the
+ * filesystem as pass=HEX in the mount data, so that it is never on a command line.
+ */
+static int lklfuse_add_pass(char *mopts, size_t size)
+{
+	char pw[1024];
+	size_t n = 0, i, len = strlen(mopts);
+	ssize_t r;
+	int ret = -1;
+
+	while (n < sizeof(pw) && (r = read(lklfuse.passfd, pw + n, sizeof(pw) - n)) != 0) {
+		if (r < 0) {
+			if (errno == EINTR)
+				continue;
+			perror("passfd");
+			goto out;
+		}
+		n += r;
+	}
+	if (n == sizeof(pw)) {
+		fprintf(stderr, "passfd: the password is too long\n");
+		goto out;
+	}
+	if (n && pw[n - 1] == '\n')
+		n--;
+	if (len + sizeof(",pass=") + 2 * n > size) {
+		fprintf(stderr, "passfd: no room for the password in the mount options\n");
+		goto out;
+	}
+	strcat(mopts, len ? ",pass=" : "pass=");
+	len = strlen(mopts);
+	for (i = 0; i < n; i++)
+		snprintf(mopts + len + 2 * i, 3, "%02x", (unsigned char)pw[i]);
+	ret = 0;
+out:
+	memset(pw, 0, sizeof(pw));
+	close(lklfuse.passfd);
+	return ret;
+}
+
 static int start_lkl(void)
 {
 	long ret;
