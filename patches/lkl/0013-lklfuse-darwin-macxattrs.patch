+/* a new netatalk blob for PATH holding Finder Info FI, laid out as netatalk's ad_rebuild_adouble_header_ea writes it */
+static long lklfuse_ad_new(const char *path, const char *fi)
+{
+	static const unsigned int ents[8][3] = {
+		{ 4, 154, 200 }, { 8, 354, 16 }, { 9, LKLFUSE_AD_FINDERI, LKLFUSE_FINDERINFO_LEN }, { 14, 370, 4 },
+		{ 0x80444556, 374, 8 }, { 0x80494E4F, 382, 8 }, { 0x8053594E, 390, 8 }, { 0x8053567E, 398, 4 },
+	};
+	char blob[LKLFUSE_AD_LEN], name[LKLFUSE_XNAME_MAX];
+	struct lkl_stat st;
+	unsigned int t;
+	int i;
+
+	memset(blob, 0, sizeof(blob));
+	lklfuse_put_be32(blob, LKLFUSE_AD_MAGIC);
+	lklfuse_put_be32(blob + 4, LKLFUSE_AD_VERSION);
+	blob[25] = 8;
+	for (i = 0; i < 8; i++) {
+		lklfuse_put_be32(blob + 26 + 12 * i, ents[i][0]);
+		lklfuse_put_be32(blob + 30 + 12 * i, ents[i][1]);
+		lklfuse_put_be32(blob + 34 + 12 * i, ents[i][2]);
+	}
+	memcpy(blob + LKLFUSE_AD_FINDERI, fi, LKLFUSE_FINDERINFO_LEN);
+	/* the dates, as netatalk's new_ad_header puts them: created, changed and read at the file's mtime, never backed up */
+	t = lkl_sys_stat(path, &st) == 0 ? (unsigned int)(st.lkl_st_mtime - LKLFUSE_AD_DATE_DELTA) : 0;
+	lklfuse_put_be32(blob + 354, t);
+	lklfuse_put_be32(blob + 358, t);
+	lklfuse_put_be32(blob + 362, 0x80000000);
+	lklfuse_put_be32(blob + 366, t);
+	snprintf(name, sizeof(name), "%s%s", lklfuse_xpre, LKLFUSE_XMETA);
+	return lkl_sys_setxattr(path, name, blob, sizeof(blob), LKLFUSE_XCREATE);
+}
+
+/* a new AFP_AfpInfo stream for PATH holding Finder Info FI, as vfs_fruit's afpinfo_pack writes it */
+static long lklfuse_afp_new(const char *path, const char *fi)
+{
+	char afp[LKLFUSE_AFPINFO_LEN], name[LKLFUSE_XNAME_MAX];
+
+	memset(afp, 0, sizeof(afp));
+	lklfuse_put_be32(afp, LKLFUSE_AFP_SIGNATURE);
+	lklfuse_put_be32(afp + 4, LKLFUSE_AFP_VERSION);
+	lklfuse_put_be32(afp + 12, 0x80000000);	/* backup time: never */
+	memcpy(afp + LKLFUSE_AFPINFO_FINDERI, fi, LKLFUSE_FINDERINFO_LEN);
+	lklfuse_xstream_name(LKLFUSE_XAFPINFO, 0, 1, name, sizeof(name));
+	return lklfuse_xstream_put(path, name, afp, sizeof(afp), LKLFUSE_XCREATE);
+}
+
+/* Mac attribute MAC of PATH, nowhere yet: in the file's own scheme, else the volume's */
+static long lklfuse_xnew(const char *path, const char *mac, const char *val, size_t size, int flags)
+{
+	enum lklfuse_xscheme s = lklfuse_file_xscheme(path);
+	int fi = strcmp(mac, LKLFUSE_FINDERINFO) == 0, rf = strcmp(mac, LKLFUSE_RESOURCEFORK) == 0;
+	char name[LKLFUSE_XNAME_MAX];
+
+	if (fi && s != XS_OURS && lklfuse_xzero(val, LKLFUSE_FINDERINFO_LEN))
+		return 0;	/* an all-zero Finder Info is none: nothing to keep */
+	if (fi && s == XS_NETATALK)
+		return lklfuse_ad_new(path, val);
+	if (fi && s == XS_FRUIT_STREAM)
+		return lklfuse_afp_new(path, val);
+	if (s == XS_FRUIT_STREAM && strcmp(mac, LKLFUSE_XAFPINFO) && strcmp(mac, LKLFUSE_XAFPRSRC)) {
+		if (lklfuse_xstream_name(rf ? LKLFUSE_XAFPRSRC : mac, 1, 1, name, sizeof(name)))
+			return -LKL_ERANGE;
+		return lklfuse_xstream_put(path, name, val, size, LKLFUSE_XCREATE);
+	}
+	if (lklfuse_xname_to_linux(mac, name, sizeof(name)))
+		return -LKL_ERANGE;
+	return lkl_sys_setxattr(path, name, val, size, flags);
+}
+
+/* Mac attribute MAC of PATH, found at AT, set to VAL (FLAGS: Linux's) */
+static long lklfuse_xput(const char *path, const char *mac, struct lklfuse_xat *at, const char *val, size_t size, int flags)
+{
+	int has;
+
+	if (at->loc == XL_USER || at->loc == XL_RSRC)
+		return lkl_sys_setxattr(path, at->name, val, size, flags);
+	if (at->loc == XL_NONE)
+		return (flags & LKLFUSE_XREPLACE) ? -LKL_ENODATA : lklfuse_xnew(path, mac, val, size, flags);
+	if (!at->data)
+		return -LKL_EIO;
+	has = at->loc == XL_STREAM || !lklfuse_xzero(at->data, LKLFUSE_FINDERINFO_LEN);
+	if ((flags & LKLFUSE_XCREATE) && has)
+		return -LKL_EEXIST;
+	if ((flags & LKLFUSE_XREPLACE) && !has)
+		return -LKL_ENODATA;
+	if (at->loc == XL_STREAM)
+		return lklfuse_xstream_put(path, at->name, val, size, LKLFUSE_XREPLACE);
+	if (at->loc == XL_AFPINFO && lklfuse_xzero(val, LKLFUSE_FINDERINFO_LEN))
+		return lkl_sys_removexattr(path, at->name);	/* as vfs_fruit does with an all-zero AfpInfo */
+	memcpy(at->data, val, LKLFUSE_FINDERINFO_LEN);	/* only those 32 bytes change */
+	return lkl_sys_setxattr(path, at->name, at->val, at->len, LKLFUSE_XREPLACE);
+}
+
+static int lklfuse_xset(const char *path, const char *mac, const char *val, size_t size, int flags)
+{
+	struct lklfuse_xat at;
+	long ret;
+
+	if (!lklfuse_xmac_ok(mac))
+		return -EPERM;
+	if (strcmp(mac, LKLFUSE_FINDERINFO) == 0 && size != LKLFUSE_FINDERINFO_LEN)
+		return -ERANGE;
+	ret = lklfuse_xfind(path, mac, &at);
+	if (ret == 0)
+		ret = lklfuse_xput(path, mac, &at, val, size, flags);
+	free(at.val);
+	return lklfuse_err(ret == -LKL_E2BIG ? -LKL_ENOSPC : ret);
+}
+
+static int lklfuse_xget(const char *path, const char *mac, char *val, size_t size)
+{
+	struct lklfuse_xat at;
+	long ret;
+
+	if (!lklfuse_xmac_ok(mac))
+		return -ENOATTR;
+	ret = lklfuse_xfind(path, mac, &at);
+	if (ret)
+		;
+	else if (at.loc == XL_USER || at.loc == XL_RSRC)
+		ret = lkl_sys_getxattr(path, at.name, val, size);
+	else if (at.loc == XL_NONE || !at.data ||
+		 (at.loc != XL_STREAM && lklfuse_xzero(at.data, LKLFUSE_FINDERINFO_LEN)))
+		ret = -LKL_ENODATA;
+	else if (size == 0)
+		ret = at.dlen;
+	else if (size < (size_t)at.dlen)
+		ret = -LKL_ERANGE;
+	else
+		memcpy(val, at.data, (ret = at.dlen));
+	free(at.val);
+	return lklfuse_err(ret);
+}
+
+static int lklfuse_xremove(const char *path, const char *mac)
+{
+	struct lklfuse_xat at;
+	long ret;
+
+	if (!lklfuse_xmac_ok(mac))
+		return -ENOATTR;
+	ret = lklfuse_xfind(path, mac, &at);
+	if (ret)
+		;
+	else if (at.loc == XL_USER || at.loc == XL_RSRC)
+		ret = lkl_sys_removexattr(path, at.name);
+	else if (at.loc == XL_NONE)
+		ret = -LKL_ENODATA;
+	else if (!at.data)
+		ret = -LKL_EIO;
+	else if (at.loc == XL_STREAM)
+		ret = lkl_sys_removexattr(path, at.name);
+	else if (lklfuse_xzero(at.data, LKLFUSE_FINDERINFO_LEN))
+		ret = -LKL_ENODATA;
+	else if (at.loc == XL_AFPINFO)
+		ret = lkl_sys_removexattr(path, at.name);
+	else {
+		memset(at.data, 0, LKLFUSE_FINDERINFO_LEN);	/* the blob keeps netatalk's other data */
+		ret = lkl_sys_setxattr(path, at.name, at.val, at.len, LKLFUSE_XREPLACE);
+	}
+	free(at.val);
+	return lklfuse_err(ret);
+}
