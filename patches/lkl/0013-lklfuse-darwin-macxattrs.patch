+	out = malloc(n + 1);	/* a Mac name is never longer than the Linux name it comes from */
+	if (!raw || !out) {
+		free(raw);
+		free(out);
+		return -ENOMEM;
+	}
+	n = lkl_sys_listxattr(path, raw, n);
+	for (off = 0; off < n; off += strlen(raw + off) + 1) {
+		r = lklfuse_xname_to_mac(raw + off, mac, sizeof(mac));
