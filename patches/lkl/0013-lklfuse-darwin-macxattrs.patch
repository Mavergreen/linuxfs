+/* carrier LNAME of PATH: the Mac name of what it carries into MAC (1), or 0 when it carries nothing readable */
+static int lklfuse_xcarried(const char *path, const char *lname, char *mac, size_t len)
+{
+	size_t p = strlen(lklfuse_xpre);
+	struct lklfuse_xat at;
+	int ok;
+
+	if (strncmp(lname, lklfuse_xpre, p) || !lklfuse_xcarrier(lname + p) ||
+	    strncmp(lname + p, LKLFUSE_XSTREAM_EXT, sizeof(LKLFUSE_XSTREAM_EXT) - 1) == 0)
+		return 0;
+	if (strcmp(lname + p, LKLFUSE_XRSRC) == 0) {
+		snprintf(mac, len, "%s", LKLFUSE_RESOURCEFORK);
+		return 1;
+	}
+	if (strcmp(lname + p, LKLFUSE_XMETA) == 0)
+		snprintf(mac, len, "%s", LKLFUSE_FINDERINFO);
+	else if (lklfuse_xstream_mac(lname + p + sizeof(LKLFUSE_XSTREAM) - 1, mac, len))
+		return 0;
+	memset(&at, 0, sizeof(at));
+	if (lklfuse_xtry(path, lname, strcmp(lname + p, LKLFUSE_XMETA) == 0 ? XL_BLOB :
+			 strcmp(mac, LKLFUSE_FINDERINFO) == 0 ? XL_AFPINFO : XL_STREAM, &at) <= 0)
+		return 0;
+	ok = at.data && (at.loc == XL_STREAM || !lklfuse_xzero(at.data, LKLFUSE_FINDERINFO_LEN));
+	free(at.val);
+	return ok;
+}
