+		if (APFS_SB(sb)->s_xts) {
+			u64 pbno, tweak;
+
+			ret = apfs_logic_to_phys_crypto(dstream, log_bno, &pbno, &tweak);
+			if (ret)
+				goto out;
+			if (tweak) {
+				if (!clear)
+					clear = kmalloc(sb->s_blocksize, GFP_KERNEL);
+				if (!clear) {
+					ret = -ENOMEM;
+					goto out;
+				}
+				memcpy(clear, bhs[idx]->b_data, sb->s_blocksize);
+				apfs_decrypt_block(sb, clear, tweak);
+				memcpy(buf, clear + off_in_block, left_in_block);
+				buf += left_in_block;
+				continue;
+			}
+		}
 		memcpy(buf, bhs[idx]->b_data + off_in_block, left_in_block);
 		buf += left_in_block;
 	}
 
 out:
+	kfree_sensitive(clear);
 	if (bhs) {
 		for (idx = 0; idx < blkcnt; idx++)
 			brelse(bhs[idx]);
