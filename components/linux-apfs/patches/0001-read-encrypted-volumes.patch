diff -ruN a/extents.c b/extents.c
--- a/extents.c
+++ b/extents.c
@@ -206,6 +206,31 @@
 	return 0;
 }
 
+/*
+ * linuxfs: as apfs_logic_to_phys_bno(), and *TWEAK is the block's XTS tweak (the extent's crypto_id plus the
+ * block's offset in it), or 0 when it is stored in the clear.
+ */
+int apfs_logic_to_phys_crypto(struct apfs_dstream_info *dstream, sector_t dsblock, u64 *bno, u64 *tweak)
+{
+	struct super_block *sb = dstream->ds_sb;
+	struct apfs_file_extent ext;
+	u64 blk_off;
+	int ret;
+
+	ret = apfs_extent_read(dstream, dsblock, &ext);
+	if (ret)
+		return ret;
+	*bno = 0;
+	*tweak = 0;
+	if (apfs_ext_is_hole(&ext))
+		return 0;
+	blk_off = dsblock - (ext.logical_addr >> sb->s_blocksize_bits);
+	*bno = ext.phys_block_num + blk_off;
+	if (ext.crypto_id)
+		*tweak = ext.crypto_id + blk_off;
+	return 0;
+}
+
