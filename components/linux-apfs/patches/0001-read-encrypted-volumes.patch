--- a/inode.c
+++ b/inode.c
@@ -31,6 +31,8 @@
 
 static int apfs_read_folio(struct file *file, struct folio *folio)
 {
+	if (APFS_SB(folio->mapping->host->i_sb)->s_xts)
+		return apfs_read_folio_encrypted(folio);
 	return mpage_read_folio(folio, apfs_get_block);
 }
 
@@ -47,6 +49,9 @@
 
 static void apfs_readahead(struct readahead_control *rac)
 {
+	/* encrypted: each folio is read, and decrypted, by apfs_read_folio() */
+	if (APFS_SB(rac->mapping->host->i_sb)->s_xts)
+		return;
 	mpage_readahead(rac, apfs_get_block);
 }
 
