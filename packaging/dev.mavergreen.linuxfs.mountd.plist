<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.mavergreen.linuxfs.mountd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/dev.mavergreen.linuxfs.mountd</string>
	</array>
	<!-- No SockListenBacklog: 10.9's launchctl does not read it, so the listen queue is launchctl's own default. When a
	     flood fills it, a connect gets ECONNREFUSED, which the mount program's client counts as no daemon (the user's own
	     mount; tools/fs.c). -->
	<key>Sockets</key>
	<dict>
		<key>Listener</key>
		<dict>
			<key>SockPathName</key>
			<string>/var/run/dev.mavergreen.linuxfs.mountd.sock</string>
			<key>SockPathMode</key>
			<integer>438</integer>
			<key>SockType</key>
			<string>stream</string>
		</dict>
	</dict>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/dev.mavergreen.linuxfs.mountd.log</string>
</dict>
</plist>
